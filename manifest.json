{
  "manifest_version": 3,
  "name": "GuideLines",
  "version": "0.5.0",
  "description": "Ultralight Figma-style rulers, guides, and measurements for the web.",
  "author": "Daniel Diya",
  "homepage_url": "https://guidelines.thedanieldiya.com",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle GuideLines",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Toggle GuideLines"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
